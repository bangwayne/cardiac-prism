# Docker Compose configuration. Native start.sh uses exported environment variables.
# Copy to .env before running scripts/docker.sh if you want to override defaults.
CARDIAC_PRISM_BIND=127.0.0.1
CARDIAC_PRISM_PORT=8502
CARDIAC_PRISM_CPU_THREADS=2
CARDIAC_PRISM_PRELOAD=0

# GPU container settings. CPU Compose always uses CARDIAC_PRISM_DEVICE=cpu.
CARDIAC_PRISM_DEVICE=cuda:0
NVIDIA_VISIBLE_DEVICES=all

# For the optional NVIDIA device-binding workaround, export
# CARDIAC_PRISM_DOCKER_DEVICE_BINDINGS=1 and NVIDIA_VISIBLE_DEVICES in your shell;
# the helper reads them before Compose loads this file. See docs/install.md.

# scripts/docker.sh supplies your host UID/GID automatically.
# Set these only when intentionally choosing another account for container files.
# CARDIAC_PRISM_UID=1000
# CARDIAC_PRISM_GID=1000
