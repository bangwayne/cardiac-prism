# Docker Compose configuration. Native start.sh uses exported environment variables.
# Copy to .env before running scripts/docker.sh if you want to override defaults.
KPRISM_BIND=127.0.0.1
KPRISM_PORT=8502
KPRISM_CPU_THREADS=2
KPRISM_PRELOAD=0

# GPU container settings. CPU Compose always uses KPRISM_DEVICE=cpu.
KPRISM_DEVICE=cuda:0
NVIDIA_VISIBLE_DEVICES=all

# scripts/docker.sh supplies your host UID/GID automatically.
# Set these only when intentionally choosing another account for container files.
# KPRISM_UID=1000
# KPRISM_GID=1000
